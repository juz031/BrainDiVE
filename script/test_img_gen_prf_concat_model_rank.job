#!/bin/bash
#SBATCH --output=/home/junruz/BrainDiVE/script/slurm_out/slurm-concat-%A_%a.out
#SBATCH -N 1
#SBATCH --job-name=prf_concat_dive
#SBATCH --time=10-00:00:00
#SBATCH -p gpu
#SBATCH --gres=gpu:1
#SBATCH --exclude=mind-0-18,mind-0-20,mind-0-22,mind-0-24
#SBATCH --mem=32G
#SBATCH --cpus-per-gpu=4
#SBATCH --array=0-1%2

set -eo pipefail

echo "SLURM_JOBID: ${SLURM_JOBID}"
echo "SLURM_ARRAY_TASK_ID: ${SLURM_ARRAY_TASK_ID}"
echo "Running on node: ${SLURM_JOB_NODELIST}"
nvidia-smi --query-gpu=name,memory.total --format=csv

source activate env2025
set -u
cd /home/junruz/BrainDiVE

# Keep these arrays the same length. Each task uses all layers recorded in the
# corresponding model's concat_metadata.json.
GEN_MODELS=(
    DINO_RN50
    ADV_RN50
)
RANK_MODELS=(
    OPEN_CLIP_RN50
    OPEN_CLIP_RN50
)

TASK_ID=${SLURM_ARRAY_TASK_ID}
if (( TASK_ID < 0 || TASK_ID >= ${#GEN_MODELS[@]} ||
      TASK_ID >= ${#RANK_MODELS[@]} )); then
    echo "Array task ${TASK_ID} has no matching model configuration" >&2
    exit 1
fi

GEN_MODEL=${GEN_MODELS[$TASK_ID]}
RANK_MODEL=${RANK_MODELS[$TASK_ID]}

# Seed mode: random, file, or fixed. File mode loads an ordered JSON list.
# Submission examples (from /home/junruz/BrainDiVE):
# sbatch --export=ALL,SEED_MODE=random script/test_img_gen_prf_concat_model_rank.job
# sbatch --export=ALL,SEED_MODE=fixed,SEED_GENERATOR_SEED=42 script/test_img_gen_prf_concat_model_rank.job
# sbatch --export=ALL,SEED_MODE=file,SEED_FILE=/path/to/seeds.json,SEED_FILE_KEY=valid_seeds script/test_img_gen_prf_concat_model_rank.job
# Use the same fixed seed/file for matched sequences across DINO and ADV.
# Leave SEED_FILE empty outside file mode and SEED_GENERATOR_SEED empty
# outside fixed mode. Per-voxel seeds.json records attempts and valid seeds.
SEED_MODE=${SEED_MODE:-fixed}
if [[ "${SEED_MODE}" == "file" ]]; then
    SEED_FILE=${SEED_FILE-/user_data/junruz/BrainDiVE/contrast_full_prf_concat_small_scale/pRF_concat_model_ranked/sub-01/gen-ADV_RN50-concat__rank-OPEN_CLIP_RN50-concat/split-01__steps-100__scale-750__sag-0.75__contrast-match-rms57.48__full-every_step__prf-every_step__luma-full-every_step-116__luma-prf-every_step-116__seeds-10__keep-all/seed-random-880caab4d307fb70/roi-hV4/voxel-rank-01__id-013177/seeds.json}
else
    SEED_FILE=${SEED_FILE:-}
fi
SEED_FILE_KEY=${SEED_FILE_KEY:-seed_set}
SEED_GENERATOR_SEED=${SEED_GENERATOR_SEED:-42}
case "${SEED_MODE}" in
    random) ;;
    file)
        if [[ ! -f "${SEED_FILE}" ]]; then
            echo "SEED_MODE=file requires an existing SEED_FILE: ${SEED_FILE}" >&2
            exit 1
        fi
        ;;
    fixed)
        if [[ -z "${SEED_GENERATOR_SEED}" ]]; then
            echo "SEED_MODE=fixed requires SEED_GENERATOR_SEED" >&2
            exit 1
        fi
        ;;
    *) echo "Unsupported SEED_MODE: ${SEED_MODE}" >&2; exit 1 ;;
esac
if [[ "${SEED_MODE}" != "file" && -n "${SEED_FILE}" ]] ||
   [[ "${SEED_MODE}" != "fixed" && -n "${SEED_GENERATOR_SEED}" ]]; then
    echo "SEED_FILE is only for file mode; SEED_GENERATOR_SEED is only for fixed mode" >&2
    exit 1
fi
SEED_ARGS=(--seed_mode "${SEED_MODE}" --seed_file_key "${SEED_FILE_KEY}")
if [[ -n "${SEED_FILE}" ]]; then
    SEED_ARGS+=(--seed_file "${SEED_FILE}")
fi
if [[ -n "${SEED_GENERATOR_SEED}" ]]; then
    SEED_ARGS+=(--seed_generator_seed "${SEED_GENERATOR_SEED}")
fi

# Default guidance follows the generation backbone; an export can override it.
case "${GEN_MODEL}" in
    DINO_RN50) BRAIN_GUIDANCE_SCALE=${BRAIN_GUIDANCE_SCALE:-300} ;;
    ADV_RN50) BRAIN_GUIDANCE_SCALE=${BRAIN_GUIDANCE_SCALE:-300} ;;
    *)
        echo "No default brain guidance scale for ${GEN_MODEL}" >&2
        exit 1
        ;;
esac

# Small experiment defaults; each can be overridden with sbatch --export.
SUBJECT_ID=${SUBJECT_ID:-1}
SPLIT_ID=${SPLIT_ID:-1}
FEATURE_ROOT=${FEATURE_ROOT:-/user_data/junruz/prf_features}
MODEL_ROOT=${MODEL_ROOT:-/user_data/junruz/prf_models/concat/split_1_zscore}
NUM_SEEDS=${NUM_SEEDS:-10}
NUM_STEPS=${NUM_STEPS:-75}
SAG_SCALE=${SAG_SCALE:-0.75}
RANKING_TOP_N=${RANKING_TOP_N:-all}
ENABLE_RANKING=${ENABLE_RANKING:-false}
# unconstrained_only skips the final adjustment; every_step guidance is unchanged.
IMAGE_SAVE_MODE=${IMAGE_SAVE_MODE:-unconstrained_only}
ROI=${ROI:-hV4}
VOXEL_RANK_START=${VOXEL_RANK_START:-1}
VOXEL_RANK_END=${VOXEL_RANK_END:-3}
SAVE_ROOT=${SAVE_ROOT:-/user_data/junruz/BrainDiVE/contrast_full_prf_concat_small_scale_iclr_test_final_final/pRF_concat_model_ranked}

# Empty attempt limit retains Python's seed-mode-aware default.
MAX_GENERATION_ATTEMPTS=${MAX_GENERATION_ATTEMPTS:-}
DUAL_SCOPE_SOLVER_MAX_NFEV=${DUAL_SCOPE_SOLVER_MAX_NFEV:-300}
DUAL_SCOPE_EVERY_STEP_ITERATIONS=${DUAL_SCOPE_EVERY_STEP_ITERATIONS:-30}
DUAL_SCOPE_PARAMETER_LIMIT=${DUAL_SCOPE_PARAMETER_LIMIT:-8.0}
DUAL_SCOPE_ENVELOPE_POWER=${DUAL_SCOPE_ENVELOPE_POWER:-0.5}
LUMINANCE_SHIFT_LIMIT=${LUMINANCE_SHIFT_LIMIT:-1.0}
SOLVER_ARGS=(
    --dual_scope_solver_max_nfev "${DUAL_SCOPE_SOLVER_MAX_NFEV}"
    --dual_scope_every_step_iterations "${DUAL_SCOPE_EVERY_STEP_ITERATIONS}"
    --dual_scope_parameter_limit "${DUAL_SCOPE_PARAMETER_LIMIT}"
    --dual_scope_envelope_power "${DUAL_SCOPE_ENVELOPE_POWER}"
    --luminance_shift_limit "${LUMINANCE_SHIFT_LIMIT}"
)
if [[ -n "${MAX_GENERATION_ATTEMPTS}" ]]; then
    SOLVER_ARGS+=(--max_generation_attempts "${MAX_GENERATION_ATTEMPTS}")
fi

# Contrast configuration. Override these with sbatch --export when needed.
# RMS rule: match for luma_rgb_clip; max/range also available with joint_solver.
# Stages (when each constraint runs): none, every_step, final.
# The pRF constraint cannot run at a stage the whole-image one skips.
CONTRAST_METHOD=${CONTRAST_METHOD:-match}
CONTRAST_FULL_IMAGE=${CONTRAST_FULL_IMAGE:-every_step}
CONTRAST_PRF=${CONTRAST_PRF:-final}
# Absolute error in 0-255 units, shared by full/pRF at either timing.
# luma_rgb_clip checks projected luma BEFORE RGB clipping; joint_solver checks
# the luma of clipped RGB. These are not PNG acceptance tolerances.
# Example: --export=ALL,CONTRAST_TOLERANCE_BYTE=0.1,LUMINANCE_TOLERANCE_BYTE=0.1
# This does not enable constraints; choose their stages separately.
CONTRAST_TOLERANCE_BYTE=${CONTRAST_TOLERANCE_BYTE:-3}
TARGET_RMS_CONTRAST=${TARGET_RMS_CONTRAST:-57.48}
MAX_RMS_CONTRAST=${MAX_RMS_CONTRAST:-16}
MIN_CONTRAST_PERCENTILE=${MIN_CONTRAST_PERCENTILE:-5}
MAX_CONTRAST_PERCENTILE=${MAX_CONTRAST_PERCENTILE:-95}
CONTRAST_STATS_JSON=${CONTRAST_STATS_JSON:-${MODEL_ROOT}/S${SUBJECT_ID}/nsd_contrast_statistics.json}

# Omitted targets use luminance_mean.byte_0_255.mean from CONTRAST_STATS_JSON
# for both scopes. Explicit targets override their respective defaults.
# With luma_rgb_clip, change the matching contrast timings as well (examples below).
LUMINANCE_FULL_IMAGE=${LUMINANCE_FULL_IMAGE:-every_step}
LUMINANCE_PRF=${LUMINANCE_PRF:-final}
# Preserve the small experiment's 116 default; explicitly export an empty
# target to use the subject's NSD mean instead (no Python target override).
TARGET_LUMINANCE_FULL_IMAGE=${TARGET_LUMINANCE_FULL_IMAGE-116}
TARGET_LUMINANCE_PRF=${TARGET_LUMINANCE_PRF-116}
LUMINANCE_TOLERANCE_BYTE=${LUMINANCE_TOLERANCE_BYTE:-3}

# Method is independent of timing. The new method enforces tolerances on
# projected luma; errors introduced by final RGB clipping are recorded only.
LUMA_CONTRAST_METHOD=${LUMA_CONTRAST_METHOD:-luma_rgb_clip}
LUMA_RGB_CLIP_MATCH_ITERATIONS=${LUMA_RGB_CLIP_MATCH_ITERATIONS:-50}
# Whole-image-only normalization uses at most N+1 passes. The dual-scope
# iteration/evaluation settings above apply only when a pRF target is active
# under the new method. None of these counts are diffusion steps.
# Paired timing exports for the new method:
# Full only: CONTRAST_FULL_IMAGE=every_step,LUMINANCE_FULL_IMAGE=every_step,CONTRAST_PRF=none,LUMINANCE_PRF=none
# Add pRF at final: CONTRAST_FULL_IMAGE=every_step,LUMINANCE_FULL_IMAGE=every_step,CONTRAST_PRF=final,LUMINANCE_PRF=final
# Final only: CONTRAST_FULL_IMAGE=final,LUMINANCE_FULL_IMAGE=final,CONTRAST_PRF=final,LUMINANCE_PRF=final
# Previous behavior: LUMA_CONTRAST_METHOD=joint_solver
if [[ ! "${LUMA_RGB_CLIP_MATCH_ITERATIONS}" =~ ^[1-9][0-9]*$ ]]; then
    echo "LUMA_RGB_CLIP_MATCH_ITERATIONS must be a positive integer" >&2
    exit 1
fi
case "${LUMA_CONTRAST_METHOD}" in
    luma_rgb_clip)
        if [[ "${CONTRAST_FULL_IMAGE}" != "${LUMINANCE_FULL_IMAGE}" ||
              "${CONTRAST_PRF}" != "${LUMINANCE_PRF}" ]]; then
            echo "luma_rgb_clip requires matching contrast/luminance timings per scope" >&2
            exit 1
        fi
        if [[ "${CONTRAST_FULL_IMAGE}" != "none" && "${CONTRAST_METHOD}" != "match" ]]; then
            echo "luma_rgb_clip requires CONTRAST_METHOD=match" >&2
            exit 1
        fi
        ;;
    joint_solver) ;;
    *) echo "Unsupported LUMA_CONTRAST_METHOD: ${LUMA_CONTRAST_METHOD}" >&2; exit 1 ;;
esac

contrast_stage_rank() {
    case "$1" in
        none) echo 0 ;;
        final) echo 1 ;;
        every_step) echo 2 ;;
        *) echo "Unsupported contrast stage: $1" >&2; exit 1 ;;
    esac
}

FULL_IMAGE_RANK=$(contrast_stage_rank "${CONTRAST_FULL_IMAGE}")
PRF_RANK=$(contrast_stage_rank "${CONTRAST_PRF}")

# The dual-scope solver drives whole-image and soft-pRF contrast to one
# shared target, so there is no pRF-only projection.
if (( PRF_RANK > FULL_IMAGE_RANK )); then
    echo "CONTRAST_PRF=${CONTRAST_PRF} needs CONTRAST_FULL_IMAGE at the same" >&2
    echo "or earlier stage, got ${CONTRAST_FULL_IMAGE}" >&2
    exit 1
fi
if [[ "${CONTRAST_PRF}" != "none" && "${CONTRAST_METHOD}" != "match" ]]; then
    echo "CONTRAST_PRF requires CONTRAST_METHOD=match" >&2
    exit 1
fi

# The method only matters while the whole-image constraint is enabled.
CONTRAST_ARGS=()
if [[ "${CONTRAST_FULL_IMAGE}" != "none" ]]; then
    case "${CONTRAST_METHOD}" in
        max)
            CONTRAST_ARGS=(
                --contrast_constraint_method max
                --max_rms_contrast "${MAX_RMS_CONTRAST}"
            )
            ;;
        range)
            if [[ ! -f "${CONTRAST_STATS_JSON}" ]]; then
                echo "Contrast statistics not found: ${CONTRAST_STATS_JSON}" >&2
                echo "Set CONTRAST_STATS_JSON with sbatch --export." >&2
                exit 1
            fi
            CONTRAST_ARGS=(
                --contrast_constraint_method range
                --min_contrast_percentile "${MIN_CONTRAST_PERCENTILE}"
                --max_contrast_percentile "${MAX_CONTRAST_PERCENTILE}"
            )
            ;;
        match)
            CONTRAST_ARGS=(
                --contrast_constraint_method match
                --target_rms_contrast "${TARGET_RMS_CONTRAST}"
            )
            ;;
        *)
            echo "Unsupported CONTRAST_METHOD: ${CONTRAST_METHOD}" >&2
            exit 1
            ;;
    esac
fi

CONTRAST_ARGS+=(
    --contrast_stats_json "${CONTRAST_STATS_JSON}"
    --contrast_constraint_full_image "${CONTRAST_FULL_IMAGE}"
    --contrast_constraint_prf "${CONTRAST_PRF}"
    --contrast_validation_tolerance "${CONTRAST_TOLERANCE_BYTE}"
)

LUMA_FULL_RANK=$(contrast_stage_rank "${LUMINANCE_FULL_IMAGE}")
LUMA_PRF_RANK=$(contrast_stage_rank "${LUMINANCE_PRF}")
if (( LUMA_PRF_RANK > LUMA_FULL_RANK )); then
    echo "LUMINANCE_PRF requires whole-image luminance at the same or earlier stage" >&2
    exit 1
fi
if [[ "${LUMINANCE_FULL_IMAGE}" != "none" &&
      "${CONTRAST_FULL_IMAGE}" != "none" && "${CONTRAST_METHOD}" != "match" ]]; then
    echo "Joint luminance/contrast requires CONTRAST_METHOD=match" >&2
    exit 1
fi
LUMINANCE_ARGS=(
    --luma_contrast_method "${LUMA_CONTRAST_METHOD}"
    --luma_rgb_clip_match_iterations "${LUMA_RGB_CLIP_MATCH_ITERATIONS}"
    --luminance_constraint_full_image "${LUMINANCE_FULL_IMAGE}"
    --luminance_constraint_prf "${LUMINANCE_PRF}"
    --luminance_validation_tolerance "${LUMINANCE_TOLERANCE_BYTE}"
)
if [[ "${LUMINANCE_FULL_IMAGE}" != "none" && -n "${TARGET_LUMINANCE_FULL_IMAGE}" ]]; then
    LUMINANCE_ARGS+=(--target_luminance_full_image "${TARGET_LUMINANCE_FULL_IMAGE}")
fi
if [[ "${LUMINANCE_PRF}" != "none" && -n "${TARGET_LUMINANCE_PRF}" ]]; then
    LUMINANCE_ARGS+=(--target_luminance_prf "${TARGET_LUMINANCE_PRF}")
fi
if [[ "${RANKING_TOP_N}" != "all" && ! "${RANKING_TOP_N}" =~ ^[1-9][0-9]*$ ]]; then
    echo "RANKING_TOP_N must be a positive integer or all" >&2
    exit 1
fi

if [[ "${IMAGE_SAVE_MODE}" != "unconstrained_only" && "${IMAGE_SAVE_MODE}" != "constrained_only" && "${IMAGE_SAVE_MODE}" != "both" ]]; then
    echo "IMAGE_SAVE_MODE must be unconstrained_only, constrained_only, or both" >&2
    exit 1
fi
if [[ "${IMAGE_SAVE_MODE}" == "unconstrained_only" && "${CONTRAST_FULL_IMAGE}" == "none" && "${CONTRAST_PRF}" == "none" && "${LUMINANCE_FULL_IMAGE}" == "none" && "${LUMINANCE_PRF}" == "none" ]]; then
    echo "IMAGE_SAVE_MODE=unconstrained_only requires an enabled constraint (every_step or final)" >&2
    exit 1
fi

if [[ "${ENABLE_RANKING}" != "true" && "${ENABLE_RANKING}" != "false" ]]; then
    echo "ENABLE_RANKING must be true or false" >&2
    exit 1
fi
echo "Ranking enabled: ${ENABLE_RANKING}"
if [[ "${ENABLE_RANKING}" == "false" ]]; then
    echo "Ranking disabled: ranking_top_n ignored; saving all valid candidates in seed-attempt order."
fi
echo "Generation model: ${GEN_MODEL} (concatenated layers)"
echo "Image save mode: ${IMAGE_SAVE_MODE} (pre-adjustment images available for every_step or final)"
echo "Seed mode: ${SEED_MODE}; generator seed: ${SEED_GENERATOR_SEED:-none}; file: ${SEED_FILE:-none}; key: ${SEED_FILE_KEY}"
echo "Brain guidance scale: ${BRAIN_GUIDANCE_SCALE}"
if [[ "${ENABLE_RANKING}" == "true" ]]; then
    echo "Ranking model: ${RANK_MODEL} (concatenated layers)"
    echo "Output ranking directory: ranking-enabled; metadata: ranking.json"
else
    echo "Ranking model: disabled (not loaded); output: ranking-disabled; metadata: generation.json"
fi
echo "Subject: ${SUBJECT_ID}; ROI: ${ROI}; voxel ranks: ${VOXEL_RANK_START}-${VOXEL_RANK_END}"
echo "Seeds per voxel: ${NUM_SEEDS}; steps: ${NUM_STEPS}; save: ${RANKING_TOP_N}"
echo "Save root: ${SAVE_ROOT}"
echo "Split: ${SPLIT_ID}; SAG scale: ${SAG_SCALE}"
echo "Maximum attempts per voxel: ${MAX_GENERATION_ATTEMPTS:-Python default (bounded by seed-file length)}"
echo "Contrast method: ${CONTRAST_METHOD}"
echo "Contrast full-image stage: ${CONTRAST_FULL_IMAGE}"
echo "Contrast pRF stage: ${CONTRAST_PRF}"
echo "Contrast float tolerance (byte units): ${CONTRAST_TOLERANCE_BYTE}"
echo "Luminance stages: full=${LUMINANCE_FULL_IMAGE}, prf=${LUMINANCE_PRF}"
echo "Luminance float tolerance (byte units): ${LUMINANCE_TOLERANCE_BYTE}"
echo "Luma/contrast method: ${LUMA_CONTRAST_METHOD}; full-only luma loop setting: ${LUMA_RGB_CLIP_MATCH_ITERATIONS} (N+1 passes)"
if [[ "${LUMA_CONTRAST_METHOD}" == "luma_rgb_clip" ]]; then
    echo "Acceptance: projected luma before RGB clipping; post-RGB-clipping errors recorded only"
    if [[ "${CONTRAST_FULL_IMAGE}" != "every_step" ]]; then
        echo "During guidance: no constraints"
    elif [[ "${CONTRAST_PRF}" == "every_step" ]]; then
        echo "During guidance: coupled full-image+pRF luma solver; max iterations=${DUAL_SCOPE_EVERY_STEP_ITERATIONS}"
    else
        echo "During guidance: full-image luma normalization; max passes=$((LUMA_RGB_CLIP_MATCH_ITERATIONS + 1))"
    fi
    if [[ "${IMAGE_SAVE_MODE}" == "unconstrained_only" ]]; then
        echo "After final decode: adjustment skipped (unconstrained_only); target checks skipped"
    elif [[ "${CONTRAST_FULL_IMAGE}" == "none" ]]; then
        echo "After final decode: no constraints"
    elif [[ "${CONTRAST_PRF}" != "none" ]]; then
        echo "After final decode: coupled full-image+pRF luma solver; max evaluations=${DUAL_SCOPE_SOLVER_MAX_NFEV}"
    else
        echo "After final decode: full-image luma normalization; max passes=$((LUMA_RGB_CLIP_MATCH_ITERATIONS + 1))"
    fi
    echo "Each enabled projection restores original color residual once, then clips RGB"
else
    echo "Acceptance: enabled targets checked on clipped RGB"
    if [[ "${IMAGE_SAVE_MODE}" == "unconstrained_only" ]]; then
        echo "After final decode: adjustment skipped (unconstrained_only); target checks skipped"
    fi
    echo "Legacy solver limits (where used): final max evaluations=${DUAL_SCOPE_SOLVER_MAX_NFEV}; every-step iterations=${DUAL_SCOPE_EVERY_STEP_ITERATIONS}"
fi
echo "Output method directory: method-${LUMA_CONTRAST_METHOD} (below the ranking-mode directory)"
echo "Luminance targets (byte units, when enabled): full=${TARGET_LUMINANCE_FULL_IMAGE:-dataset mean}, prf=${TARGET_LUMINANCE_PRF:-dataset mean}"
echo "NSD statistics: ${CONTRAST_STATS_JSON}"
printf 'Contrast arguments:'
printf ' %q' "${CONTRAST_ARGS[@]}"
printf '\n'
printf 'Luminance/method arguments:'
printf ' %q' "${LUMINANCE_ARGS[@]}"
printf '\n'

# Run the small experiment without changing the full-size launcher.
python -u run_image_generation_concat_pRF_model_ranking.py \
    --subject_id "${SUBJECT_ID}" \
    --gen_model "${GEN_MODEL}" \
    --rank_model "${RANK_MODEL}" \
    --split_id "${SPLIT_ID}" \
    --feature_root "${FEATURE_ROOT}" \
    --model_root "${MODEL_ROOT}" \
    "${CONTRAST_ARGS[@]}" \
    "${LUMINANCE_ARGS[@]}" \
    "${SEED_ARGS[@]}" \
    "${SOLVER_ARGS[@]}" \
    --num_steps "${NUM_STEPS}" \
    --sag_scale "${SAG_SCALE}" \
    --roi "${ROI}" \
    --brain_guidance_scale "${BRAIN_GUIDANCE_SCALE}" \
    --num_seeds "${NUM_SEEDS}" \
    --ranking_top_n "${RANKING_TOP_N}" \
    --enable_ranking "${ENABLE_RANKING}" \
    --image_save_mode "${IMAGE_SAVE_MODE}" \
    --voxel_rank_range "${VOXEL_RANK_START}" "${VOXEL_RANK_END}" \
    --save_root "${SAVE_ROOT}"
